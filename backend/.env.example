# Example configuration. The backend does NOT load this file automatically:
# export the variables in the shell that starts uvicorn, for example
#   set -a; source .env; set +a
#   ./.venv/bin/uvicorn app.main:app --port 8000
# No credentials are used. OPENAI_API_KEY is not needed.

# Comma-separated origins allowed to call the API from a browser.
ATLAS_CORS_ORIGINS=http://localhost:3000

# --- Phase 4: narrative report via a local LM Studio server (optional) ---
# false -> /api/report returns the deterministic report (status "disabled").
ATLAS_NARRATION_ENABLED=false
# Must be a loopback URL (127.0.0.1, localhost or ::1). Clients cannot override it.
ATLAS_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Required when enabled. Copy an id exactly from: curl http://127.0.0.1:1234/v1/models
ATLAS_LM_STUDIO_MODEL=
# 1..300 seconds. One attempt, no retries.
ATLAS_LM_STUDIO_TIMEOUT_SECONDS=45
# 128..8192
ATLAS_LM_STUDIO_MAX_OUTPUT_TOKENS=1200
# 0..2
ATLAS_LM_STUDIO_TEMPERATURE=0
# 1..8. Extra concurrent requests get the deterministic report with MODEL_BUSY.
ATLAS_NARRATION_MAX_CONCURRENT_REQUESTS=1
# Send response_format=json_schema. Enable only after the manual check passes with it.
ATLAS_LM_STUDIO_USE_JSON_SCHEMA=false
